# Everything the build writes
# (in any directory: a run started from the wrong directory makes one there)
out/
# your own images of the two discs and Update 2 (build/discs.py; README.md)
/isos/
# where the ext/rez/ submodule was: the old disc images and installs, left
# on disk for you to keep or delete
/ext/rez/
# build/build.mk's Wine prefix, generated rules and header dependencies
/.wine/
/.build/
# the project files put every output in a built/ directory
src/**/[Bb]uilt/

__pycache__/
*.log
!src/**/*.log
# agents' worktrees (ext/tools/agentwt.sh)
/.worktrees/
# generated by flex/bison at build time (src/Game/ObjectDLL/ObjectShared/)
src/Game/ObjectDLL/ObjectShared/AnimationLex.o
src/Game/ObjectDLL/ObjectShared/AnimationParse.o
src/Game/ObjectDLL/ObjectShared/AnimationLexSymbols.h
# scratch: the vtable-layout probe (out/work/probe.sh compiles in it, as s:)
/src/tron20src_probe/
