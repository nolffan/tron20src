/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "ServerApp.ico"
IDI_SELECTED            ICON    DISCARDABLE     "selected.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

// RETAIL: Tron 2.0's, as TRONSrv.exe has it (written out by ext/tools/rsrc2rc.py)
IDD_GAMESERVER DIALOG 0, 0, 423, 279
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | DS_SETFONT | DS_MODALFRAME
CAPTION "TRON 2.0 - Dedicated Server"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Server Info", IDC_STATIC, 7, 7, 267, 64
    LTEXT           "Server Name:", IDC_STATIC, 17, 17, 47, 12
    CONTROL         "<server name>", IDC_SERVER_NAME, "Static", WS_GROUP | SS_LEFTNOWORDWRAP, 68, 17, 198, 12
    LTEXT           "Running Time:", IDC_STATIC, 17, 41, 47, 12
    CONTROL         "<server time>", IDC_SERVER_TIME, "Static", WS_GROUP | SS_LEFTNOWORDWRAP, 68, 41, 66, 12
    LTEXT           "Current Players:", IDC_STATIC, 18, 172, 50, 12
    EDITTEXT        IDC_TOTALPLAYERS, 218, 40, 48, 12, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    RTEXT           "Total/Unique Players:", IDC_STATIC, 141, 40, 71, 12
    EDITTEXT        IDC_PEAKPLAYERS, 218, 29, 47, 12, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    LTEXT           "Time in Level:", IDC_STATIC, 310, 17, 45, 12
    LTEXT           "Static", IDC_TIMEINLEVEL, 358, 17, 36, 12
    LTEXT           "Average Ping:", IDC_STATIC, 109, 172, 46, 12
    EDITTEXT        IDC_AVERAGEPING, 158, 172, 20, 12, ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP
    GROUPBOX        "Players", IDC_STATIC, 7, 72, 267, 115
    CONTROL         "List1", IDC_PLAYERS, "SysListView32", WS_BORDER | WS_TABSTOP | 0x8005, 17, 82, 250, 85
    PUSHBUTTON      "&Boot Player", IDC_PLAYER_BOOT, 199, 170, 68, 12, WS_DISABLED
    GROUPBOX        "Levels", IDC_STATIC, 283, 7, 132, 180
    CONTROL         "List1", IDC_LEVELS, "SysListView32", WS_BORDER | WS_TABSTOP | 0xc08d, 293, 30, 114, 133
    PUSHBUTTON      "&Next Level", IDC_COMMANDS_NEXTLEVEL, 293, 170, 55, 12
    PUSHBUTTON      "Select &Level", IDC_COMMANDS_SELLEVEL, 352, 170, 55, 12
    PUSHBUTTON      "S&top Server", IDC_STOPSERVER, 199, 53, 68, 12
    GROUPBOX        "Console", IDC_STATIC, 7, 192, 408, 80
    EDITTEXT        IDC_CONSOLE_COMMAND, 17, 256, 330, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "Clear", IDC_CONSOLE_CLEAR, 352, 256, 55, 12
    EDITTEXT        IDC_CONSOLE_WINDOW, 17, 202, 390, 52, WS_VSCROLL | ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY
    DEFPUSHBUTTON   "*Send*", IDC_CONSOLE_SEND, 376, 0, 40, 8, NOT WS_VISIBLE
    PUSHBUTTON      "*Button1*", IDC_STARTUP, 334, 0, 40, 8, NOT WS_VISIBLE
    LTEXT           "Game Type:", IDC_STATIC, 17, 29, 47, 12
    CONTROL         "<game type>", IDC_GAME_TYPE, "Static", WS_GROUP | SS_LEFTNOWORDWRAP, 68, 29, 66, 12
    RTEXT           "Peak Players:", IDC_STATIC, 163, 29, 49, 12
    LTEXT           "<players>", IDC_NUM_PLAYERS, 70, 172, 31, 12
END

IDD_SELECTCONFIG DIALOG DISCARDABLE  0, 0, 162, 81
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select Config"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,10,55,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,100,55,50,14
    COMBOBOX        IDC_CONFIG,10,30,140,55,CBS_DROPDOWNLIST | CBS_SORT | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "Server Config File:",IDC_STATIC,10,15,140,10
END


#ifndef _MAC
/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", ""
            VALUE "CompanyName", "Monolith Productions Inc.\0"
            VALUE "FileDescription", "TRON 2.0 Stand-Alone Server\0"
            VALUE "FileVersion", "1, 0, 0, 0\0"
            VALUE "InternalName", "TRONServ\0"
            VALUE "LegalCopyright", "Copyright (C) 2003, Monolith Productions, Inc.\0"
            VALUE "LegalTrademarks", "\0"
            VALUE "OriginalFilename", "TRONServ.exe\0"
            VALUE "PrivateBuild", "\0"
            VALUE "ProductName", "TRON 2.0\0"
            VALUE "ProductVersion", "1, 0, 0, 0\0"
            VALUE "SpecialBuild", "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#endif    // !_MAC


