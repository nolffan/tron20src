    IDS_DIALOGUE_10836              "Whatever the people want, pro'.  It's all good."
END

STRINGTABLE DISCARDABLE
BEGIN
    IDS_DIALOGUE_10853              "Word, pro', that track is dope."
    IDS_DIALOGUE_10854              "If you say so, pro'."
    IDS_DIALOGUE_10855              "Track 3 comin' up!"
    IDS_DIALOGUE_10856              "High level compiler program right?"
    IDS_DIALOGUE_10857              "I hear you got Legacy code from TRON to compile. Let's see it."
    IDS_DIALOGUE_10858              "Very nice. This would be worth a lot on the net."
    IDS_DIALOGUE_10860              "Okay ... so where's TRON?"
    IDS_DIALOGUE_10861              "Uh ... TRON is retired. I'm going to be the host."
    IDS_DIALOGUE_10862              "Jet, I really think I should be the host. It's me that it needs to help."
    IDS_DIALOGUE_10863              "I guess that makes sense.  So the usual fee?"
END

STRINGTABLE DISCARDABLE
BEGIN
    IDS_DIALOGUE_10864              "It's on me-I'm bored stiff with all these delays."
    IDS_DIALOGUE_10865              "Ah ... I just got a call signal from Guest. I'll go find out what he wants."
    IDS_DIALOGUE_10866              "Connecting to live security video feed."
    IDS_DIALOGUE_10868              "Dad?"
    IDS_DIALOGUE_10869              "Oh, no ... Ma3a!"
    IDS_DIALOGUE_10870              "Live security video deactivated."
    IDS_DIALOGUE_10871              "Come forward, Ma3a. You have something I want-to destroy."
    IDS_DIALOGUE_10872              "Ma3a, don't move!"
    IDS_DIALOGUE_10874              "Do you not know who I am? I'm Thorne, your Master User."
    IDS_DIALOGUE_10875              "You're not my User."
    IDS_DIALOGUE_10876              "There is something different about you, script, but unfortunately I have no time for messy interrogations. Now step aside."
    IDS_DIALOGUE_10877              "Ma3a!"
END

STRINGTABLE DISCARDABLE
BEGIN
    IDS_DIALOGUE_10882              "You too are a User."
    IDS_DIALOGUE_10883              "Ma3a, what happened to your shell?"
    IDS_DIALOGUE_10884              "I've been freed!"
    IDS_DIALOGUE_10885              "No no no no no ... "
    IDS_DIALOGUE_10886              "Byte!"
    IDS_DIALOGUE_10887              "Jet, run, the Legacy code has ... changed me."
