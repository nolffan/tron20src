STRINGTABLE DISCARDABLE
BEGIN
    IDS_DIALOGUE_10001              " "
    IDS_DIALOGUE_10002              "Please ... I've got to get back to my routing. I'm already behind on my deliveries this cycle."
    IDS_DIALOGUE_10003              "You have privileges I require."
    IDS_DIALOGUE_10004              "I'm just a simple email script! I ..."
    IDS_DIALOGUE_10005              "I know what you are ... and I know what you'll become."
    IDS_DIALOGUE_10006              "Ahhhh ... "
    IDS_DIALOGUE_10007              "Tell me ... what is your function?"
    IDS_DIALOGUE_10008              "I serve Thorne, my Master User."
    IDS_DIALOGUE_10009              "Jet, do you think your dad would mind if I had some of his popcorn?"
    IDS_DIALOGUE_10010              "Huh? Oh ... sure, have all you want."
    IDS_DIALOGUE_10011              "Hello, Jet."
    IDS_DIALOGUE_10014              "Yeah?"
    IDS_DIALOGUE_10015              "I'm a little surprised you turned down the level six programming position."
END

STRINGTABLE DISCARDABLE
BEGIN
    IDS_DIALOGUE_10016              "Look dad, I know you're disappointed ... "
    IDS_DIALOGUE_10018              "I'm happy making games. Life is short, Pop. I plan to enjoy it."
    IDS_DIALOGUE_10019              "You sound like Flynn. "
    IDS_DIALOGUE_10020              "Hold on, son."
    IDS_DIALOGUE_10021              "Ma3a, run a security diagnostic."
    IDS_DIALOGUE_10022              "Yes, Alan One. "
    IDS_DIALOGUE_10023              "Results?"
    IDS_DIALOGUE_10024              "A virus has entered the system via email. Lab drives one, two and four infected."
    IDS_DIALOGUE_10025              "Jet, we'll have to continue this conversation later ..."
    IDS_DIALOGUE_10027              "This is a restricted area, you can't just come barging in here."
    IDS_DIALOGUE_10028              "Dad?"
    IDS_DIALOGUE_10029              "Get your hands off me!"
    IDS_DIALOGUE_10030              "Dad, can you hear me?"
END

STRINGTABLE DISCARDABLE
BEGIN
    IDS_DIALOGUE_10032              "Ma3a, where's my father?"
    IDS_DIALOGUE_10033              "Alan Two, I require immediate assistance."
    IDS_DIALOGUE_10034              "What do you mean?"
    IDS_DIALOGUE_10035              "Contingency protocol activated."
    IDS_DIALOGUE_10036              "Laser activity in five seconds."
    IDS_DIALOGUE_10037              "Ma3a, stop what you are doing!"
    IDS_DIALOGUE_10038              "Put on goggles. "
    IDS_DIALOGUE_10039              "Clear digitizing bay."
    IDS_DIALOGUE_10041              "Ma3a? What did you do?"
    IDS_DIALOGUE_10043              "Six more sub-directories have been compromised. The corruption managed to slip past our scheduled scans ... obviously an inside job."
    IDS_DIALOGUE_10044              "That's not the exit."
END

STRINGTABLE DISCARDABLE
BEGIN
    IDS_DIALOGUE_10048              "Byte, can you get philosophical later?"
    IDS_DIALOGUE_10049              "Wait here while I clear this area of danger."
    IDS_DIALOGUE_10050              "Dad, this whole ""life inside the computer"" experience has really opened my eyes -- I'll never drop another laptop as long as I live."
    IDS_DIALOGUE_10051              "Assistance?"
END

