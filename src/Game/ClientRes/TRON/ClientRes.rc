// tron20src: retail CRes.dll's resources, written back out with
// ext/tools/rsrc2rc.py. Compiled, each resource is the retail one byte for
// byte.
//
// The string IDs are retail's numbers. The IDs that the game code uses
// have retail's values in ..\Shared\ClientResShared.h and ClientRes.h
// (found from the strings' text), and these strings have their names here.
// The other IDs in the headers are Build 69's, older than retail: a string
// has one of those names only where the name contains its own number
// (IDS_DIALOGUE_10143 and similar); the other strings keep their numbers.
//
// arrow.cur (cursor 125) is retail art: build/appres.py writes it out of
// the retail image into src/Game/built/retail/ClientRes at build time.
// credits.txt (UTF-16) and intro.txt are retail's TEXT resources as they are.
#include "ClientRes.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
#ifdef _WIN32
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)
#endif //_WIN32

125                     CURSOR DISCARDABLE     "arrow.cur"

