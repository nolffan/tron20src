    IDS_DIALOGUE_10478              "I have insufficient data to answer your request."
    IDS_DIALOGUE_10479              "There must be a connection between the correction algorithms and the TRON Legacy code."
END

STRINGTABLE DISCARDABLE
BEGIN
    IDS_DIALOGUE_10480              "I'll perform a system search."
    IDS_DIALOGUE_10481              "I have located a severely fragmented email that contains strings of text referring to TRON Legacy."
    IDS_DIALOGUE_10482              "Is it repairable?"
