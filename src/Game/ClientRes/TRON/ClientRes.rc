END

STRINGTABLE DISCARDABLE
BEGIN
    IDS_DIALOGUE_10800              "Yes. The request is urgent."
    IDS_DIALOGUE_10801              "What happened to you?"
    IDS_DIALOGUE_10802              "Looks like an old version of Mercury got installed."
    IDS_DIALOGUE_10803              "Reformatting always bums me out -- let's hit the Bar."
    IDS_DIALOGUE_10804              "I thought I lost you.  This is very important ... (garbled) ... do not ... "
    IDS_DIALOGUE_10805              "Guest! Do not what?"
    IDS_DIALOGUE_10806              "Internal query initiated."
    IDS_DIALOGUE_10808              "Jet, have you found a compiler?"
    IDS_DIALOGUE_10809              "Yes, I believe so. Meet me in front of the Progress Bar."
    IDS_DIALOGUE_10810              "The situation has worsened. It was no coincidence the corruption attacked the lab server."
    IDS_DIALOGUE_10811              "This Master User Thorne, he's after you specifically-I've heard the same rumors. But why?"
    IDS_DIALOGUE_10812              "I fear it's because of the correction algorithms."
    IDS_DIALOGUE_10813              "You mean to tell me that YOU have the algorithms Oh great!"
    IDS_DIALOGUE_10814              "Yes. Alan One embedded them into my code."
    IDS_DIALOGUE_10815              "TRON Legacy code must be capable of protecting the correction algorithms."
END

STRINGTABLE DISCARDABLE
BEGIN
    IDS_DIALOGUE_10817              "We must hurry and get the Tron Legacy code compiled."
