STRINGTABLE DISCARDABLE
BEGIN
    IDS_DIALOGUE_13008              "I'll get right on it."
    IDS_DIALOGUE_13009              "I'm on it."
    IDS_DIALOGUE_13010              "As you command."
    IDS_DIALOGUE_13011              "Right away."
    IDS_DIALOGUE_13013              "Signing off."
    IDS_DIALOGUE_13014              "Returning to storage."
    IDS_DIALOGUE_13015              "Quitting."
    IDS_DIALOGUE_13016              "Shutting down."
    IDS_DIALOGUE_13017              "Jet, activate the I/O Node. I've got something that may be of interest to you."
