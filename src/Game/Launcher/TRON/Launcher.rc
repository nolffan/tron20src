// Microsoft Visual C++ generated resource script.
//
// tron20src: Tron 2.0's launcher resources, as the retail Tron.exe (1.030)
// has them, written out of it (ext/tools/rsrc2rc.py) with the names of
// resource.h: NOLF2's launcher script's resources (its source release's
// TO2\RES\Lang\EN\Launcher.rc) and Tron's own. Build 69's
// Launcher\TRON\Launcher.rc, a German and English script of May 2002, has
// the buttons of a launcher Tron no longer has (Multiplayer, Host, Join,
// Find). The art is the retail game's: build/appres.py writes it out of
// the retail image into src/Game/built/retail/Launcher/ (the project's /i
// path) before the build, under the names NOLF2's script gives the same
// resources (the buttons under their resource names).
#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
#ifdef _WIN32
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)
#endif //_WIN32

