VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", ""
            VALUE "CompanyName", "Monolith Productions, Inc.\0"
            VALUE "FileDescription", "TRON 2.0 Launcher\0"
            VALUE "FileVersion", "1, 0, 0, 0\0"
            VALUE "InternalName", "Launcher\0"
            VALUE "LegalCopyright", "Copyright (C) 2002 Monolith Productions, Inc.\0"
            VALUE "LegalTrademarks", ""
            VALUE "OriginalFilename", "TRON2.EXE\0"
            VALUE "PrivateBuild", ""
            VALUE "ProductName", "TRON 2.0 Launcher Application\0"
            VALUE "ProductVersion", "1, 0, 0, 0\0"
            VALUE "SpecialBuild", ""
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4b0
    END
END

STRINGTABLE DISCARDABLE
BEGIN
    IDS_APPNAME                     "TRON 2.0"
    IDS_APPEXE                      "TRON2.exe"
    IDS_DISPLAY_WARNING             "The available display options on your system will now be enumerated.  This may take some time depending on what hardware is installed.\n\nIf nothing shows up in the display dialog, please verify that DirectX is installed properly on your system."
    IDS_OPTIONS_WARNING             "WARNING!  Tinkering with the advanced options can cause the game to run worse (or not at all) depending on your system configuration."
    IDS_APPCD1CHECK                 "\\TRON.EXE"
    IDS_APPCD2CHECK                 "\\DATA\\GAME2.REZ"
    IDS_REZBASE                     "GAME"
    IDS_SETUPEXE                    "SETUP.EXE"
    IDS_SERVEREXE                   "TRON2Svr.EXE"
    IDS_LANGUAGE                    "English"
    IDS_INSERTCD2                   "Please remove the TRON 2.0 Disc 2 from your drive and replace it with the TRON 2.0 Disc 1."
    IDS_INSERTCD                    "Please insert the TRON 2.0 Disc 1 into your drive."
    IDS_CANTLAUNCHSETUP             "ERROR - Unable to launch the setup program.  Please make sure that your TRON 2.0 CD is in the drive and try again."
    IDS_NORENS                      "No renderers were found.  This problem is usually due to DirectX not being properly installed.  Please verify that DirectX is installed and try again.."
    IDS_HELP_DISABLESOUND           "This will disable all sound effects."
END

STRINGTABLE DISCARDABLE
BEGIN
    IDS_HELP_DISABLEMUSIC           "This will disable the use of DirectMusic. Some sound cards may have incompatibilities with DirectMusic.  Use this for troubleshooting only."
    IDS_HELP_DISABLEMOVIES          "This will disable the logo and intro movies from playing."
    IDS_HELP_DISABLEFOG             "This will disable all atmospheric (not clipping plane) fog. There should be no performance increase or decrease. However, this might possibly be useful on cards that ""almost"" support table fog."
    IDS_HELP_DISABLEJOYSTICKS       "This will disable all joysticks and gamepads.  Use this if your particular joystick is causing problems when the game starts."
    IDS_HELP_DISABLETRIPLEBUFFERING "This will disable a feature on some video cards that can improve performance, but uses more of the card's video memory as a result.  Most AGP video cards benefit from this feature being enabled.  However, this may cause lock-ups on a few PCI video cards."
    IDS_HELP_DISABLEHARDWARECURSOR  "This will disable the use of a hardware cursor. Some older cards do not support the hardware cursor."
    IDS_HELP_DISABLEANIMATEDLOADSCREEN "This will disable the use of an animated loading screen. Use this for troubleshooting."
    IDS_HELP_RESTOREDEFAULTS        "This restores all configuration settings to the original defaults. This includes resetting the key configuration, detail level and sound options. This is useful if you've changed settings, and you just want things back the way they were. "
    IDS_HELP_ALWAYSSPECIFY          "Advanced users only."
    IDS_CANTFINDREZFILE             "ERROR - Unable to find the Game.rez file.  Please make sure that TRON 2.0 is installed properly and that your TRON 2.0 disc 1 CD is in the drive."
    IDS_CANTLAUNCHCLIENTEXE         "ERROR - Could not launch LITHTECH.EXE.  Please make sure that TRON 2.0 is installed properly."
    IDS_DETAIL_HEADER               "In order to get the best gameplay experience from TRON 2.0, please select the initial performance setting you would like the game to use.  You can change this setting later using TRON 2.0's in-game menus."
    IDS_DETAIL_LOW                  "Low detail will provide the best game performance at the sacrifice of visual quality.  Required System Specs:  PIII 500 MHz, 256MB Ram, 32MB GeForce 2 or equivalent video card with T&L."
    IDS_DETAIL_MEDIUM               "Medium detail will provide a good trade-off between game performance and visual quality.  Recommended System Specs:   PIII 1 GHz, 512MB Ram, 64MB GeForce 3 or equivalent video card."
    IDS_DETAIL_HIGH                 "High detail will provide the best visual quality, but game performance may suffer on slower systems.  Recommended System Specs:   P4 2 GHz, 512MB Ram, 128MB GeForce 4 Ti or equivalent video card."
    IDS_CANTLAUNCHSERVER            "ERROR - Unable to launch the stand-alone server.  Please verify that TRON 2.0 is properly installed on your machine and try again."
END

