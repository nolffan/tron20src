IDD_LAUNCHER_DIALOG DIALOGEX 0, 0, 600, 250
STYLE WS_POPUP | WS_VISIBLE | DS_3DLOOK | DS_SETFONT
EXSTYLE WS_EX_APPWINDOW
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    CONTROL         "Minimize", IDC_MINIMIZE, "Button", WS_TABSTOP | BS_OWNERDRAW, 292, 6, 10, 10
    CONTROL         "Close", IDC_CLOSE, "Button", WS_TABSTOP | BS_OWNERDRAW, 302, 6, 10, 10
    CONTROL         "Display", IDC_DISPLAY, "Button", WS_TABSTOP | BS_OWNERDRAW, 243, 98, 50, 14
    CONTROL         "Quit", IDC_QUIT, "Button", WS_TABSTOP | BS_OWNERDRAW, 243, 154, 50, 14
    CONTROL         "Options", IDC_OPTIONS, "Button", WS_TABSTOP | BS_OWNERDRAW, 243, 116, 50, 14
    CONTROL         "Uninstall", IDC_UNINSTALL, "Button", WS_TABSTOP | BS_OWNERDRAW, 243, 134, 50, 14
    CONTROL         "Install", IDC_PLAY, "Button", WS_TABSTOP | BS_OWNERDRAW, 413, 25, 50, 14
    CONTROL         "PublisherWeb", IDC_PUBLISHERWEB, "Button", WS_TABSTOP | BS_OWNERDRAW, 39, 193, 36, 40
    CONTROL         "CompanyWeb", IDC_COMPANYWEB, "Button", WS_TABSTOP | BS_OWNERDRAW, 84, 211, 62, 18
    CONTROL         "SierraWeb", IDC_SIERRAWEB, "Button", WS_TABSTOP | BS_OWNERDRAW, 158, 211, 85, 23
    CONTROL         "Help", IDC_HELPBUTTON, "Button", WS_TABSTOP | BS_OWNERDRAW, 243, 76, 50, 14
    CONTROL         "Custom", IDC_CUSTOM, "Button", WS_TABSTOP | BS_OWNERDRAW, 243, 175, 50, 14
END

IDD_OPTIONS_DIALOG DIALOG 0, 0, 205, 181
STYLE WS_POPUP | DS_SETFONT
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "Close", IDC_OD_CLOSE, "Button", WS_TABSTOP | BS_OWNERDRAW, 181, 3, 10, 10
    CONTROL         "DisableSound", IDC_OD_DISABLESOUND, "Button", WS_TABSTOP | BS_OWNERDRAW, 19, 15, 50, 16
    CONTROL         "DisableMusic", IDC_OD_DISABLEMUSIC, "Button", WS_TABSTOP | BS_OWNERDRAW, 19, 32, 50, 13
    CONTROL         "DisableMovies", IDC_OD_DISABLEMOVIES, "Button", WS_TABSTOP | BS_OWNERDRAW, 19, 46, 50, 13
    CONTROL         "DisableTripleBuffering", IDC_OD_DISABLETRIPLEBUFFERING, "Button", WS_TABSTOP | BS_OWNERDRAW, 111, 17, 50, 15
    CONTROL         "DisableJoysticks", IDC_OD_DISABLEJOYSTICKS, "Button", WS_TABSTOP | BS_OWNERDRAW, 112, 33, 50, 12
    CONTROL         "DisableHardwareCursor", IDC_OD_DISABLEHARDWARECURSOR, "Button", WS_TABSTOP | BS_OWNERDRAW, 112, 46, 50, 12
    CONTROL         "DisableAnimatedLoadScreen", IDC_OD_DISABLEANIMATEDLOADSCREEN, "Button", WS_TABSTOP | BS_OWNERDRAW, 17, 77, 50, 14
    CONTROL         "RestoreDefaultSettings", IDC_OD_RESTOREDEFAULTSETTINGS, "Button", WS_TABSTOP | BS_OWNERDRAW, 19, 61, 50, 15
    CONTROL         "AlwaysSpecify", IDC_OD_ALWAYSSPECIFY, "Button", WS_TABSTOP | BS_OWNERDRAW, 28, 122, 50, 10
    CONTROL         "OK", IDC_OD_OK, "Button", WS_TABSTOP | BS_OWNERDRAW, 12, 161, 50, 14
    CONTROL         "Cancel", IDC_OD_CANCEL, "Button", WS_TABSTOP | BS_OWNERDRAW, 69, 161, 50, 14
    EDITTEXT        IDC_COMMANDLINE, 15, 97, 166, 14, ES_AUTOHSCROLL | NOT WS_BORDER
    LTEXT           "What the hell am I looking at here?!", IDC_HELPTEXT, 20, 140, 162, 8
    CONTROL         "DisableSoundHardware", IDC_OD_DISABLEHARDWARESOUND, "Button", WS_TABSTOP | BS_OWNERDRAW, 112, 60, 50, 13
    CONTROL         "DisableSoundFilters", IDC_OD_DISABLESOUNDFILTERS, "Button", WS_TABSTOP | BS_OWNERDRAW, 112, 77, 50, 15
END

